{
  "name": "extend-computer-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "types": "wrangler types",
    "db:local": "wrangler d1 migrations apply extend-computer --local",
    "db:remote": "wrangler d1 migrations apply extend-computer --remote",
    "deploy": "npm run build && npm run db:remote && wrangler deploy",
    "test": "node --import tsx --test tests/*.test.ts",
    "email:preview": "tsx watch scripts/email-preview.ts",
    "test:email:visual": "node --import tsx tests/email-visual.ts",
    "test:email:visual:update": "node --import tsx tests/email-visual.ts --update",
    "test:api": "node tests/account-api.mjs",
    "test:browser": "playwright test --grep @ui",
    "test:visual": "playwright test --grep @visual --workers=4",
    "test:visual:baseline": "playwright test --grep @visual --workers=4 --update-snapshots=all",
    "test:browser:integration": "playwright test --grep @integration --workers=1",
    "test:browser:report": "playwright show-report"
  },
  "dependencies": {
    "@ariakit/react": "0.4.42",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "input-otp": "^1.5.0",
    "lucide-react": "1.61.0",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "6.11.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "agent-browser": "0.39.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "playwright": "1.63.0",
    "pngjs": "^5.0.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "overrides": {
    "miniflare": {
      "undici": "^7.30.1"
    }
  }
}
