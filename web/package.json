{
  "name": "extend-computer-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "types": "wrangler types",
    "db:local": "wrangler d1 migrations apply extend-computer --local",
    "db:remote": "wrangler d1 migrations apply extend-computer --remote",
    "deploy": "npm run build && npm run db:remote && wrangler deploy",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "test:api": "node tests/account-api.mjs",
    "test:browser": "node tests/passkey-browser.mjs"
  },
  "dependencies": {
    "@ariakit/react": "0.4.40",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "input-otp": "^1.5.0",
    "lucide-react": "1.49.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "agent-browser": "0.38.2",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "wrangler": "4.146.0"
  },
  "engines": {
    "node": ">=24"
  }
}
