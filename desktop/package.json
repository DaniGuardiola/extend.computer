{
  "name": "extend-computer-desktop",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "ui:review": "vite --mode ui-review --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "native:permissions": "bash ../scripts/macos/build-permission-flow.sh && sh ../native/macos/low-jitter/build-bundled.sh && npm run native:updater && npm run native:display",
    "native:display": "bash ../scripts/macos/build-display-helper.sh",
    "desktop:dev": "python3 ../scripts/macos/dev-app.py run",
    "desktop:build:dev": "python3 ../scripts/macos/dev-app.py build",
    "desktop:signing:setup": "python3 ../scripts/macos/dev-app.py setup",
    "desktop:wifi:prepare": "python3 ../scripts/macos/dev-wifi.py",
    "native:updater": "bash ../scripts/macos/build-updater.sh",
    "changeset": "npm run changeset --prefix .. --",
    "release:version": "npm run release:version --prefix ..",
    "release:check": "python3 ../scripts/release.py check"
  },
  "dependencies": {
    "@ariakit/react": "^0.4.42",
    "@tauri-apps/api": "^2.12.4",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": "^22.11 || ^24 || >=26",
    "npm": ">=10.9.0"
  },
  "license": "MIT"
}
