#!/usr/bin/python3
"""extend.computer development-only privileged helper installation. Run using sudo."""
import hashlib
import json
import os
from pathlib import Path
import plistlib
import re
import stat
import subprocess
import sys

LABEL = "computer.extend.lowjitter-development"
DEST = Path("/Library/PrivilegedHelperTools") / LABEL
STATE = Path("/private/var/db") / LABEL
PLIST = Path("/Library/LaunchDaemons") / (LABEL + ".plist")
BINARY = DEST / "ExtendComputerLowJitter"
EXPECTED = "BUILD_SHA256"


def run(args):
    return subprocess.run(args, check=True, capture_output=True, text=True)


def secure_parent(path):
    # Resolve only the known system paths, then check every actual component.
    resolved = path.resolve(strict=True)
    for item in [resolved, *resolved.parents]:
        info = item.lstat()
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
            raise RuntimeError("Unsafe system directory: " + str(item))


def write_new(path, content, mode):
    descriptor = os.open(str(path), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
    with os.fdopen(descriptor, "wb") as handle:
        handle.write(content)
        handle.flush()
        os.fsync(handle.fileno())


def install():
    uid = int(os.environ.get("SUDO_UID", "0"))
    if uid == 0:
        raise RuntimeError("Run sudo from the intended non-root extend.computer user")
    payload = Path(__file__).with_name("ExtendComputerLowJitter").read_bytes()
    if hashlib.sha256(payload).hexdigest() != EXPECTED:
        raise RuntimeError("Build changed; rebuild installer before proceeding")
    for parent in [DEST.parent, STATE.parent, PLIST.parent]:
        secure_parent(parent)
    if any(os.path.lexists(path) for path in [DEST, STATE, PLIST]):
        raise RuntimeError("Installation paths already exist; inspect/uninstall before replacing")
    DEST.mkdir(mode=0o755)
    STATE.mkdir(mode=0o700)
    write_new(BINARY, payload, 0o755)
    run(["/usr/bin/codesign", "--verify", "--strict", str(BINARY)])
    details = run(["/usr/bin/codesign", "-d", "--verbose=4", str(BINARY)]).stderr
    match = re.search(r"^CDHash=([0-9a-f]{40})$", details, re.MULTILINE)
    if not match:
        raise RuntimeError("Missing code-directory hash")
    config = {"uid": uid, "requirement": 'cdhash H"' + match[1] + '"'}
    write_new(DEST / "configuration.json", json.dumps(config).encode(), 0o644)
    plist = {
        "Label": LABEL,
        "ProgramArguments": [str(BINARY), "serve"],
        "MachServices": {LABEL: True},
        "RunAtLoad": True,
        "KeepAlive": True,
        "ThrottleInterval": 2,
        "ProcessType": "Background",
        "UserName": "root",
        "Umask": 0o077,
    }
    write_new(PLIST, plistlib.dumps(plist), 0o644)
    run(["/bin/launchctl", "bootstrap", "system", str(PLIST)])
    print("Installed. No AWDL lease requested. Run installed binary with status or test-30s as your normal user.")


def uninstall():
    for parent in [DEST.parent, STATE.parent, PLIST.parent]:
        secure_parent(parent)
    # Do not lose the recovery journal if the helper cannot restore the interface.
    result = subprocess.run(["/bin/launchctl", "bootout", "system/" + LABEL], capture_output=True, text=True)
    if result.returncode:
        # An absent job is fine; a still-running job must not lose its files.
        existing = subprocess.run(["/bin/launchctl", "print", "system/" + LABEL], capture_output=True)
        if existing.returncode == 0:
            raise RuntimeError("Could not stop helper; files preserved")
    secure_parent(DEST)
    info = BINARY.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
        raise RuntimeError("Unsafe installed binary")
    run([str(BINARY), "recover"])
    # Remove only known files. Unexpected content keeps the directory for inspection.
    PLIST.unlink(missing_ok=True)
    (DEST / "configuration.json").unlink()
    BINARY.unlink()
    DEST.rmdir()
    (STATE / "restore").unlink(missing_ok=True)
    (STATE / "lease.lock").unlink(missing_ok=True)
    STATE.rmdir()
    print("Uninstalled; recovery completed.")


if os.geteuid() != 0:
    sys.exit("Run this installer with sudo in your own Terminal.")
try:
    if sys.argv[1:] == ["uninstall"]:
        uninstall()
    elif sys.argv[1:] == ["upgrade"]:
        # Validate the staged replacement before stopping the installed service.
        payload = Path(__file__).with_name("ExtendComputerLowJitter").read_bytes()
        if hashlib.sha256(payload).hexdigest() != EXPECTED:
            raise RuntimeError("Build changed; rebuild installer before proceeding")
        if int(os.environ.get("SUDO_UID", "0")) == 0:
            raise RuntimeError("Run sudo from the intended non-root extend.computer user")
        uninstall()
        install()
    elif not sys.argv[1:]:
        install()
    else:
        raise RuntimeError("Usage: install.py [uninstall|upgrade]")
except Exception as error:
    sys.exit(str(error) + ". Existing files and any recovery journal were preserved where possible.")
