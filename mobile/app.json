{
  "expo": {
    "name": "extend.computer",
    "slug": "extend-computer",
    "version": "0.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "scheme": "extend-computer",
    "ios": {
      "bundleIdentifier": "computer.extend.ios.development",
      "supportsTablet": true,
      "appleTeamId": "59QTVLL4JP",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "extend.computer finds and connects to your paired computers and devices on this network.",
        "NSBonjourServices": [
          "_extendpair._tcp",
          "_extendprobe._tcp",
          "_extendpresence._tcp"
        ]
      }
    },
    "android": {
      "package": "computer.extend.android.development",
      "permissions": [
        "INTERNET",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_MULTICAST_STATE"
      ],
      "predictiveBackGestureEnabled": true,
      "allowBackup": true
    },
    "plugins": [
      "expo-router",
      "./plugins/with-account-network",
      "./plugins/with-standalone-debuggable",
      "./plugins/with-identity-backup",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "buildArchs": [
              "arm64-v8a",
              "x86_64"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
